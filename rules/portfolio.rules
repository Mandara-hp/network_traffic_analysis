# Portfolio Suricata rules - written from the five analyses in analyses/.
# Test them with: tools/test-rules.sh   (results: docs/05-detection-testing.md)
# SIDs 1000000-1999999 are the range reserved for local rules.

# Case 01 - NetSupport RAT C2 (analyses/01-malware-c2/README.md)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"NetSupport RAT C2 check-in"; flow:established,to_server; http.method; content:"POST"; http.user_agent; content:"NetSupport Manager"; http.uri; content:"fakeurl.htm"; classtype:trojan-activity; sid:1000001; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET 443 (msg:"Cleartext HTTP to port 443"; flow:established,to_server; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; sid:1000002; rev:2;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NetSupport Gateway C2 response"; flow:established,to_client; http.server; content:"NetSupport Gateway"; classtype:trojan-activity; sid:1000003; rev:1;)

# Case 02 - phishing download + PowerShell C2 (analyses/02-phishing-download/README.md)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Payload fetch via /api/file/get-file/"; flow:established,to_server; http.uri; content:"/api/file/get-file/"; startswith; classtype:trojan-activity; sid:1000101; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HTTP without User-Agent - possible PowerShell C2 loop"; flow:established,to_server; http.header_names; content:!"User-Agent"; threshold:type both, track by_src, count 20, seconds 120; classtype:trojan-activity; sid:1000102; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Implant status report in URI"; flow:established,to_server; http.uri; content:"?k="; content:"status"; distance:0; classtype:trojan-activity; sid:1000103; rev:1;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"TLS SNI is a bare IPv4 address"; flow:established,to_server; tls.sni; pcre:"/^\d{1,3}(\.\d{1,3}){3}$/"; classtype:bad-unknown; sid:1000104; rev:1;)

# Case 03 - port scan (analyses/03-port-scan/README.md)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Possible TCP port scan - SYN burst"; flags:S,12; threshold:type both, track by_src, count 100, seconds 10; classtype:attempted-recon; sid:1000201; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Possible nmap SYN scan - Win 1024 crafted SYN"; flags:S,12; window:1024; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000202; rev:1;)

# Case 04 - DNS exfiltration (analyses/04-dns-exfil/README.md)
alert dns $HOME_NET any -> any 53 (msg:"Possible DNS exfiltration - very long query name"; dns.query; pcre:"/(^|\.)[a-z0-9]{40,}\./i"; threshold:type both, track by_src, count 10, seconds 60; classtype:policy-violation; sid:1000301; rev:2;)
